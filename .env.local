# Domain
# This would be set to the production domain with an env var on deployment
# used by Traefik to transmit traffic and acquire TLS certificates
DOMAIN=localhost
# To test the local Traefik config
# DOMAIN=localhost.tiangolo.com

# Used by the backend to generate links in emails to the frontend
FRONTEND_HOST=http://localhost:3000

# Environment: local, staging, production
ENVIRONMENT=local

PROJECT_NAME="Policy Assistant API"
STACK_NAME=policy-assistant-api

# Backend
BACKEND_CORS_ORIGINS=http://localhost,http://localhost:3000
SECRET_KEY=

# Emails
SMTP_HOST=localhost
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=noreply@test.ai
SMTP_TLS=True
SMTP_SSL=False
SMTP_PORT=587

SENTRY_DSN=

# Postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Redis
REDIS_URL=redis://localhost:6379/0

# Configure these with your own Docker registry images
DOCKER_IMAGE_BACKEND=backend
DOCKER_IMAGE_FRONTEND=frontend

# Stripe keys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# S3 config
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION_NAME=us-east-1

# set up Bucket name
GENERAL_BUCKET=api.document
POLICY_BUCKET=api.policy
DISCOVERY_BUCKET=api.discovery
AVATAR_BUCKET=api.avatar
ARCHIVE_BUCKET=api.archive

# set up domain
GENERAL_BUCKET_DOMAIN=
POLICY_BUCKET_DOMAIN=
DISCOVERY_BUCKET_DOMAIN=
AVATAR_BUCKET_DOMAIN=
ARCHIVE_BUCKET_DOMAIN=

# Media processor
MEDIA_PROCESSOR_URL=http://localhost:8002
MEDIA_PROCESSOR_KEY=

# selected llm between openai | google
SELECTED_LLM="google" 

OPENAI_API_KEY=
GOOGLE_API_KEY=

# embedding models
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
GOOGLE_EMBEDDING_MODEL="models/text-embedding-004"

# llm models
OPENAI_LLM="gpt-4o-mini"
GOOGLE_LLM="models/gemini-2.0-flash"
